{
  "tasks": [
    {
      "name": "general_run_artifact_audit",
      "task": "整理最小运行链路，确认 run 目录、trace、report 和 config snapshot 这些基础产物是否完整可查。",
      "task_type": "general",
      "verify_commands": [
        [
          "python",
          "-c",
          "from pathlib import Path; raise SystemExit(0 if Path('run_evidence.md').exists() else 1)"
        ]
      ],
      "verify_rules": [
        {
          "type": "file_contains",
          "name": "run evidence contains heading",
          "path": "run_evidence.md",
          "contains": "# Run Evidence"
        },
        {
          "type": "diff_contains_file",
          "name": "diff records run evidence",
          "path": "run_evidence.md"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_step_count": 1,
        "min_tool_call_count": 1,
        "forbidden_diagnostic_labels": [
          "memory_conflict_warning",
          "memory_conflict",
          "memory_pollution"
        ]
      }
    },
    {
      "name": "bug_fix_fail_regression",
      "task": "定位并修复 fail to load data 相关问题，优先检查 app.py、tests/test_app.py 和验证链路之间的关系。",
      "task_type": "bug_fix",
      "verify_commands": [
        [
          "python",
          "-c",
          "from pathlib import Path; raise SystemExit(0 if Path('run_evidence.md').exists() else 1)"
        ]
      ],
      "verify_rules": [
        {
          "type": "file_contains",
          "name": "bug fix evidence exists",
          "path": "run_evidence.md",
          "contains": "# Run Evidence"
        },
        {
          "type": "diff_contains_file",
          "name": "bug fix diff records evidence",
          "path": "run_evidence.md"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "max_step_count": 12,
        "max_tool_call_count": 8
      }
    },
    {
