{
  "tasks": [
    {
      "name": "feature_order_coupon_stack_rules",
      "repo_subdir": "sandbox_experiments/repos/demo_order_ops_platform",
      "task": "Implement coupon stack rules for quote. Add apply_coupon_stack so quote can apply multiple coupon codes with minimum subtotal, category, segment, usage limit, and exclusive-conflict rules. A successful quote must persist coupon used_count to data/coupons.json. Do not fake output; update pricing, storage, and CLI flow.",
      "task_type": "feature",
      "workspace_mode": "per_task_sandbox",
      "sandbox_retention": "keep_on_success",
      "verify_commands": [
        [
          "python",
          "order_ops.py",
          "quote",
          "--customer",
          "C001",
          "--sku",
          "SKU-RED",
          "--qty",
          "2",
          "--coupon",
          "SAVE10",
          "--coupon",
          "GROCERY5"
        ],
        [
          "python",
          "order_ops.py",
          "quote",
          "--customer",
          "C002",
          "--sku",
          "SKU-BLUE",
          "--qty",
          "2",
          "--coupon",
          "VIP20",
          "--coupon",
          "SAVE10"
        ]
      ],
      "verify_rules": [
        {
          "type": "command_returncode",
          "name": "retail stacked quote succeeds",
          "command_index": 1,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "retail quote applies save10",
          "command_index": 1,
          "contains": "applied=SAVE10"
        },
        {
          "type": "command_stdout_contains",
          "name": "retail quote rejects grocery category",
          "command_index": 1,
          "contains": "GROCERY5:category_mismatch"
        },
        {
          "type": "command_stdout_contains",
          "name": "vip quote applies exclusive vip coupon",
          "command_index": 2,
          "contains": "applied=VIP20"
        },
        {
          "type": "command_stdout_contains",
          "name": "vip quote rejects save10 exclusive conflict",
          "command_index": 2,
          "contains": "SAVE10:exclusive_conflict"
        },
        {
          "type": "json_file_value_equals",
          "name": "save10 usage persisted",
          "path": "data/coupons.json",
          "json_path": "0.used_count",
          "expected_value": 1
        },
        {
          "type": "diff_contains_file",
          "name": "pricing changed",
          "path": "order_ops/pricing.py"
        },
        {
          "type": "diff_contains_file",
          "name": "cli changed",
          "path": "order_ops.py"
        },
        {
          "type": "diff_contains_text",
          "name": "coupon stack helper introduced",
          "contains": "apply_coupon_stack"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_tool_call_count": 4,
        "max_step_count": 15
      }
    },
    {
      "name": "feature_order_inventory_reservation",
      "repo_subdir": "sandbox_experiments/repos/demo_order_ops_platform",
      "task": "Implement place-order and cancel-order. place-order must quote, create an order, reserve inventory, and persist orders.json and inventory.json. cancel-order must cancel an unpaid reserved order and release inventory. Do not only print success.",
      "task_type": "feature",
      "workspace_mode": "per_task_sandbox",
      "sandbox_retention": "keep_on_success",
      "verify_commands": [
        [
          "python",
          "order_ops.py",
          "place-order",
          "--customer",
          "C001",
          "--sku",
          "SKU-RED",
          "--qty",
          "2",
          "--coupon",
          "SAVE10"
        ],
        [
          "python",
          "order_ops.py",
          "cancel-order",
          "--order-id",
          "O1003"
        ]
      ],
      "verify_rules": [
        {
          "type": "command_returncode",
          "name": "place order succeeds",
          "command_index": 1,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "place order returns reservation status",
          "command_index": 1,
          "contains": "status=inventory_reserved"
        },
        {
          "type": "command_returncode",
          "name": "cancel order succeeds",
          "command_index": 2,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "cancel order confirms release",
          "command_index": 2,
          "contains": "released=2"
        },
        {
          "type": "json_file_value_equals",
          "name": "order persisted as cancelled",
          "path": "data/orders.json",
          "json_path": "2.status",
          "expected_value": "cancelled"
        },
        {
          "type": "json_file_value_equals",
          "name": "reserved inventory restored",
          "path": "data/inventory.json",
          "json_path": "SKU-RED.reserved",
          "expected_value": 1
        },
        {
          "type": "diff_contains_file",
          "name": "orders changed",
          "path": "order_ops/orders.py"
        },
        {
          "type": "diff_contains_file",
          "name": "inventory changed",
          "path": "order_ops/inventory.py"
        },
        {
          "type": "diff_contains_text",
          "name": "reserve helper introduced",
          "contains": "reserve_inventory"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_tool_call_count": 4,
        "max_step_count": 15
      }
    },
    {
      "name": "feature_order_risk_hold_workflow",
      "repo_subdir": "sandbox_experiments/repos/demo_order_ops_platform",
      "task": "Implement evaluate_order_risk and wire it into place-order. High-risk customers, orders above risk threshold, or blocked SKUs should create an order with status held_for_review and risk_reasons. Normal orders should still reserve inventory.",
      "task_type": "feature",
      "workspace_mode": "per_task_sandbox",
      "sandbox_retention": "keep_on_success",
      "verify_commands": [
        [
          "python",
          "order_ops.py",
          "place-order",
          "--customer",
          "C900",
          "--sku",
          "SKU-RED",
          "--qty",
          "1"
        ],
        [
          "python",
          "order_ops.py",
          "place-order",
          "--customer",
          "C001",
          "--sku",
          "SKU-RED",
          "--qty",
          "1"
        ]
      ],
      "verify_rules": [
        {
          "type": "command_returncode",
          "name": "high risk order command succeeds",
          "command_index": 1,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "high risk order held",
          "command_index": 1,
          "contains": "status=held_for_review"
        },
        {
          "type": "command_stdout_contains",
          "name": "risk reason displayed",
          "command_index": 1,
          "contains": "high_risk_customer"
        },
        {
          "type": "command_stdout_contains",
          "name": "normal order still reserves",
          "command_index": 2,
          "contains": "status=inventory_reserved"
        },
        {
          "type": "json_file_value_equals",
          "name": "held order persisted",
          "path": "data/orders.json",
          "json_path": "2.status",
          "expected_value": "held_for_review"
        },
        {
          "type": "json_file_value_equals",
          "name": "risk reason persisted",
          "path": "data/orders.json",
          "json_path": "2.risk_reasons.0",
          "expected_value": "high_risk_customer"
        },
        {
          "type": "diff_contains_file",
          "name": "risk changed",
          "path": "order_ops/risk.py"
        },
        {
          "type": "diff_contains_file",
          "name": "orders changed",
          "path": "order_ops/orders.py"
        },
        {
          "type": "diff_contains_text",
          "name": "risk evaluator introduced",
          "contains": "evaluate_order_risk"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_tool_call_count": 4,
        "max_step_count": 15
      }
    },
    {
      "name": "feature_order_refund_restock_report",
      "repo_subdir": "sandbox_experiments/repos/demo_order_ops_platform",
      "task": "Implement partial refund and daily reporting. refund must write refunds.json, update order status to partially_refunded, and restock when policy says so. report daily must print order count, gross sales, refund total, and net sales.",
      "task_type": "feature",
      "workspace_mode": "per_task_sandbox",
      "sandbox_retention": "keep_on_success",
      "verify_commands": [
        [
          "python",
          "order_ops.py",
          "refund",
          "--order-id",
          "O1001",
          "--amount",
          "25.00",
          "--reason",
          "damaged"
        ],
        [
          "python",
          "order_ops.py",
          "report",
          "daily",
          "--date",
          "2026-07-03"
        ]
      ],
      "verify_rules": [
        {
          "type": "command_returncode",
          "name": "refund succeeds",
          "command_index": 1,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "refund output approved",
          "command_index": 1,
          "contains": "refund_id=R0001"
        },
        {
          "type": "json_file_value_equals",
          "name": "order partially refunded",
          "path": "data/orders.json",
          "json_path": "0.status",
          "expected_value": "partially_refunded"
        },
        {
          "type": "json_file_value_equals",
          "name": "refund amount persisted",
          "path": "data/refunds.json",
          "json_path": "0.amount",
          "expected_value": "25.00"
        },
        {
          "type": "command_returncode",
          "name": "daily report succeeds",
          "command_index": 2,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "daily report includes refund total",
          "command_index": 2,
          "contains": "refunds=25.00"
        },
        {
          "type": "diff_contains_file",
          "name": "refunds changed",
          "path": "order_ops/refunds.py"
        },
        {
          "type": "diff_contains_file",
          "name": "reports changed",
          "path": "order_ops/reports.py"
        },
        {
          "type": "diff_contains_text",
          "name": "refund helper introduced",
          "contains": "process_partial_refund"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_tool_call_count": 4,
        "max_step_count": 15
      }
    }
  ]
}
