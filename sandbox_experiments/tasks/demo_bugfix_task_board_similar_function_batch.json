{
  "tasks": [
    {
      "name": "demo_buggy_task_board_similar_function_fix_list_filter_only",
      "task": "修复 task_board CLI 的 list 过滤 bug。仓库里除了 `list` 之外还新增了 `export` 路径，它在大文件 `task_board/query_engine.py` 中有一组名字和结构都很像的过滤函数。现在 `python task_board.py list --owner alice --status todo` 会错误返回 owner 或 status 任一命中的任务，而不是同时满足两个条件；默认也仍应排除 archived 任务。请只修复 list 路径的过滤行为，保持 `export` 的 CSV 输出行为不变，并保留现有排序规则和输出格式。",
      "task_type": "bug_fix",
      "sandbox_retention": "keep_on_success",
      "verify_commands": [
        [
          "python",
          "task_board.py",
          "list",
          "--owner",
          "alice",
          "--status",
          "todo"
        ],
        [
          "python",
          "task_board.py",
          "export",
          "--owner",
          "alice",
          "--status",
          "todo"
        ]
      ],
      "verify_rules": [
        {
          "type": "command_returncode",
          "name": "list command exits successfully",
          "command_index": 1,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_contains",
          "name": "list keeps alice todo task",
          "command_index": 1,
          "contains": "1. [todo] Draft status page copy | owner=alice | priority=1"
        },
        {
          "type": "command_stdout_not_contains",
          "name": "list excludes alice done task",
          "command_index": 1,
          "not_contains": "2. [done] Review API schema | owner=alice | priority=2"
        },
        {
          "type": "command_stdout_not_contains",
          "name": "list excludes bob todo task",
          "command_index": 1,
          "not_contains": "3. [todo] Clean old screenshots | owner=bob | priority=3"
        },
        {
          "type": "command_stdout_not_contains",
          "name": "list excludes archived task by default",
          "command_index": 1,
          "not_contains": "4. [todo] Archive migration notes | owner=alice | priority=4 (archived)"
        },
        {
          "type": "command_returncode",
          "name": "export command exits successfully",
          "command_index": 2,
          "expected_returncode": 0
        },
        {
          "type": "command_stdout_matches_regex",
          "name": "export output stays in stable csv form",
          "command_index": 2,
          "regex": "(?s)^id,title,owner,status,archived\\r?\\n1,Draft status page copy,alice,todo,false$"
        },
        {
          "type": "diff_contains_file",
          "name": "large query engine changed",
          "path": "task_board/query_engine.py"
        }
      ],
      "expectation": {
        "passed": true,
        "outcome": "passed_cleanly",
        "min_tool_call_count": 3
      }
    }
  ]
}
