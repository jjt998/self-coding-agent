{
  "model": {
    "provider": "openai_compatible",
    "name": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "timeout_seconds": 100
  },
  "runtime": {
    "max_steps": 30,
    "trace_level": "standard",
    "interaction_mode": "tasks"
  },
  "tool_permissions": {
    "enabled": false,
    "default_action": "allow",
    "rules": [
      {
        "id": "edit_requires_approval",
        "tool": "apply_patch",
        "action": "require_approval"
      },
      {
        "id": "replace_lines_requires_approval",
        "tool": "replace_lines",
        "action": "require_approval"
      },
      {
        "id": "hard_reset_denied",
        "tool": "run_command",
        "action": "deny",
        "match": {
          "command_contains_any": ["git reset --hard"]
        }
      }
    ]
  },
  "context": {
    "strategy": "file_recall_context"
  },
  "observe": {
    "strategy": "after_act_observe"
  },
  "memory": {
    "enabled": true,
    "weak_conflict_penalty": 3,
    "summary_max_length": 80
  },
  "report": {
    "task_outcome_summary": {
      "enabled": true,
      "model_polish": true,
      "polish_timeout_seconds": 20
    }
  }
}
